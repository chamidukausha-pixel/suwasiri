rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Main applicant uid OR family virtual ids: `{uid}_wife`, `{uid}_child`, …
    // so Sakuni / Denuk bookings, vault, vaccines work under Chamidu's account.
    function isHouseholdPatient(pid) {
      return isSignedIn() && (
        pid == request.auth.uid ||
        pid.matches('^' + request.auth.uid + '_.+$')
      );
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /vault/{reportId} {
      allow read, write: if isSignedIn()
        && isHouseholdPatient(resource.data.patientId);
      allow create: if isSignedIn()
        && isHouseholdPatient(request.resource.data.patientId);
    }

    match /vaccinations/{vaccineId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isHouseholdPatient(request.resource.data.patientId);
      allow delete: if isSignedIn()
        && isHouseholdPatient(resource.data.patientId);
    }

    match /appointments/{bookingId} {
      // Patients write their own / family-member bookings. Any signed-in GP Care
      // staff can read so clinic / video slots appear on the shared calendar.
      allow create: if isSignedIn()
        && isHouseholdPatient(request.resource.data.patientId);
      allow read: if isSignedIn();
      allow update, delete: if isSignedIn()
        && (isHouseholdPatient(resource.data.patientId)
            || request.resource.data.patientId == resource.data.patientId);
    }

    // WebRTC signaling for Suwasiri App ↔ GP Care telehealth (no extra devices).
    match /telehealth_sessions/{sessionId} {
      allow read, write: if isSignedIn();
      match /{sub}/{docId} {
        allow read, write: if isSignedIn();
      }
    }

    match /notifications/{notifId} {
      allow read, write: if isSignedIn();
    }

    match /prescriptions/{rxId} {
      // Patients read their household scripts. GP Care staff issue e-Rx from
      // the clinic / telehealth room onto the same collection.
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn()
        && (isHouseholdPatient(resource.data.patientId)
            || request.resource.data.patientId == resource.data.patientId);
    }

    // Live Suwasariya dispatcher GPS — owner writes; signed-in can read active sessions.
    match /sos_sessions/{sessionId} {
      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.patientId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.patientId == request.auth.uid
            || resource.data.shareLiveGps == true);
    }
  }
}
