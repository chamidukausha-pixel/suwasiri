rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /vault/{reportId} {
      allow read, write: if isSignedIn()
        && resource.data.patientId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid;
    }

    match /vaccinations/{vaccineId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid;
    }

    match /appointments/{bookingId} {
      allow read, write: if isSignedIn()
        && resource.data.patientId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid;
    }

    match /notifications/{notifId} {
      allow read, write: if isSignedIn();
    }

    match /prescriptions/{rxId} {
      allow read, write: if isSignedIn()
        && resource.data.patientId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid;
    }

    // Live Suwasariya dispatcher GPS — owner writes; signed-in can read active sessions.
    match /sos_sessions/{sessionId} {
      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.patientId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.patientId == request.auth.uid
            || resource.data.shareLiveGps == true);
    }
  }
}
